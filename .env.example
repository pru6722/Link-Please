# LinkPlease Resilient Backend Environment Variables

# The API key supplied by the Mock PseudoGram Platform.
# This key is used to sign headers for incoming webhooks and authorize outgoing DM API calls.
MOCK_API_KEY="your_pseudogram_api_key_here"

# Database Connection String. For SQLite with WAL mode, specify:
# sqlite:////Users/prudhvisailingineni/Desktop/LinkPlease/linkplease.db
# For PostgreSQL (Render/Railway), use: postgresql://user:password@host:port/dbname
DATABASE_URL="sqlite:////Users/prudhvisailingineni/Desktop/LinkPlease/linkplease.db"

# Base URL for the PseudoGram Mock API.
MOCK_API_BASE_URL="https://pseudogram-api.onrender.com"

# Set to 'true' to disable signature verification on POST /webhook for local testing.
SKIP_SIGNATURE_VERIFICATION="false"
